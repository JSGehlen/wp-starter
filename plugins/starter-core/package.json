{
	"name": "starter-core",
	"version": "0.1.0",
	"private": true,
	"description": "Blocks and editor panel for the Starter Core plugin.",
	"scripts": {
		"build": "npm run build:blocks && npm run build:editor",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest",
		"build:editor": "wp-scripts build seo-panel.js --webpack-src-dir=src/editor --output-path=build/editor",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --blocks-manifest"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.2.0"
	}
}
